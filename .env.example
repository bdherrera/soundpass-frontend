# Base de la API tal como la ve el navegador. Por omisión se usa el proxy del mismo origen (/api/v1),
# porque el backend no envía cabeceras CORS. Si el backend habilita CORS se puede
# poner la URL completa, p. ej. http://localhost:8080/api/v1
VITE_API_URL=/api/v1
# Base contra la que se resuelven las rutas relativas de imágenes (galería, medios).
VITE_MEDIA_URL=/media/
# Solo para `npm run dev`: a dónde reenvía Vite las peticiones /api (no llega al navegador)
API_PROXY_TARGET=http://localhost:8080
